# Dependencies (installed by `npm install` on the host)
node_modules/

# Runtime data & secrets (never commit — created by server.js on first run)
server-config.json
data/
.env

# Neon workspace link (machine-specific: which org/project/branch you're on)
.neon

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Claude Code local session state (machine-specific, not project config)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.neon
